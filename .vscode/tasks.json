{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clang build",
            "type": "shell",
            "command": "clang++.exe -Wall -Wextra -g -O0 -std=c++20 ${fileBasename}",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "BC: Diff current file",
            "type": "process",
            "command": "git",
            "args": [
                "difftool",
                "HEAD",
                "--no-prompt",
                "--",
                "${relativeFile}"
            ],
            "problemMatcher": []
        }
    ]
}